Options -Indexes -MultiViews
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)(?:\.[^/]*|uploads|build-files|node_modules)(?:/|$)" - [F,END,NC]
</IfModule>
<FilesMatch "(?i)^(?:\..*|init_db\.php|schema_hardening\.php|roomplan_shell\.php|database\.php|room_access\.php|room_admin_input\.php|booking_calendar\.php|avatars\.php|booking_helpers\.php|(?:package(?:-lock)?\.json|tailwind\.config\..*)|.*\.(?:db|sqlite|sqlite3)(?:[-.].*)?)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; frame-ancestors 'self'; form-action 'self'; object-src 'none'"
</IfModule>
